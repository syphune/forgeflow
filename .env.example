FORGEFLOW_HTTP_ADDRESS=:8080
FORGEFLOW_ENV=development
FORGEFLOW_DEV_AUTH=true
# Web client settings (copy these into apps/web/.env.local for a split local dev server).
# Next server-side rewrite target. Keep NEXT_PUBLIC_FORGEFLOW_API_URL unset when using same-origin rewrites.
# UI cutover: legacy keeps the existing workspace, new redirects the root to the App Router shell.
FORGEFLOW_UI_MODE=new
# UI language: vi by default; set en for the English catalog.
NEXT_PUBLIC_FORGEFLOW_LOCALE=vi
# Docker web dev-auth values; use only with FORGEFLOW_DEV_AUTH=true locally.
# NEXT_PUBLIC_FORGEFLOW_DEV_AUTH=true
# Use UUIDs that exist in your local database; these are the integration-test fixtures.
# NEXT_PUBLIC_FORGEFLOW_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# NEXT_PUBLIC_FORGEFLOW_ACTOR_ID=00000000-0000-0000-0000-000000000004
# NEXT_PUBLIC_FORGEFLOW_PROJECT_ID=00000000-0000-0000-0000-000000000003
# FORGEFLOW_BACKEND_URL=http://localhost:18080
# Set this and the actor IDs only for header-auth local development.
# NEXT_PUBLIC_FORGEFLOW_DEV_AUTH=false
# NEXT_PUBLIC_FORGEFLOW_API_URL=http://localhost:8080
# NEXT_PUBLIC_FORGEFLOW_ORGANIZATION_ID=
# NEXT_PUBLIC_FORGEFLOW_ACTOR_ID=
# NEXT_PUBLIC_FORGEFLOW_PROJECT_ID=
# Set DATABASE_URL only after PostgreSQL migrations and a real auth adapter are configured.
# DATABASE_URL=postgres://forgeflow:forgeflow@localhost:5432/forgeflow?sslmode=disable
# GitHub OAuth (leave empty to disable the login route).
# FORGEFLOW_GITHUB_OAUTH_CLIENT_ID=
# FORGEFLOW_GITHUB_OAUTH_CLIENT_SECRET=
# FORGEFLOW_GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
# FORGEFLOW_WEB_BASE_URL=http://localhost:3000
# Comma-separated browser origins when the Web app is also exposed through a tunnel/domain.
# FORGEFLOW_ALLOWED_WEB_ORIGINS=http://localhost:3000,https://forgeflow.example.com
# FORGEFLOW_SECURE_COOKIES=false
# GitHub App webhook secret. Required before accepting webhook payloads.
# FORGEFLOW_GITHUB_WEBHOOK_SECRET=
# GitHub App repository picker. Use the App ID, URL slug and downloaded private key.
# FORGEFLOW_GITHUB_APP_ID=
# FORGEFLOW_GITHUB_APP_SLUG=
# FORGEFLOW_GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Or keep the downloaded PEM outside the env file:
# FORGEFLOW_GITHUB_APP_PRIVATE_KEY_FILE=/absolute/path/to/forgeflow-app.private-key.pem
# FORGEFLOW_GITHUB_APP_CALLBACK_URL=http://localhost:8080/api/v1/integrations/github/install/callback
# GitHub App user authorization for Desktop clone/push. Use the App client ID/secret,
# not the separate sign-in OAuth App credentials. Generate a random 32-byte key and encode it with base64.
# FORGEFLOW_GITHUB_APP_CLIENT_ID=
# FORGEFLOW_GITHUB_APP_CLIENT_SECRET=
# FORGEFLOW_GITHUB_APP_USER_CALLBACK_URL=http://localhost:8080/api/v1/integrations/github/user/callback
# FORGEFLOW_GITHUB_APP_TOKEN_ENCRYPTION_KEY=
# Optional bearer token for the internal Prometheus-compatible /metrics endpoint.
# FORGEFLOW_METRICS_TOKEN=
# Private attachment storage directory. Docker overrides this with its persistent volume path.
# FORGEFLOW_ATTACHMENTS_DIR=./data/attachments
# Use local for development or s3 for an S3-compatible object store in production.
# FORGEFLOW_ATTACHMENT_STORAGE=local
# FORGEFLOW_ATTACHMENT_S3_ENDPOINT=https://s3.example.com
# FORGEFLOW_ATTACHMENT_S3_ACCESS_KEY=
# FORGEFLOW_ATTACHMENT_S3_SECRET_KEY=
# FORGEFLOW_ATTACHMENT_S3_REGION=us-east-1
# FORGEFLOW_ATTACHMENT_S3_BUCKET=forgeflow
# FORGEFLOW_ATTACHMENT_S3_PREFIX=attachments
# FORGEFLOW_ATTACHMENT_S3_SECURE=true
# Optional OTLP HTTP trace export. Docker Compose points this at its collector automatically.
# FORGEFLOW_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# FORGEFLOW_OTEL_SERVICE_NAME=forgeflow-api
# Server-side autonomous runner. `make dev` starts the autonomous profile.
# FORGEFLOW_RUNNER_URL=http://runner:8090
# FORGEFLOW_RUNNER_TOKEN=use-a-long-random-token
# FORGEFLOW_RUNNER_WORKSPACE_ROOT=/var/lib/forgeflow/workspaces
# FORGEFLOW_RUNNER_IMAGE=forgeflow/agent-runner:1.0.0
# FORGEFLOW_RUNNER_CPU_LIMIT=2
# FORGEFLOW_RUNNER_MEMORY_LIMIT=2g
# FORGEFLOW_RUNNER_PIDS_LIMIT=512
# Keep none for isolated jobs; set bridge when Codex/Claude needs provider egress.
# FORGEFLOW_RUNNER_NETWORK_MODE=none
# Optional override for the Forgeflow MCP endpoint used by server-side Codex/Claude jobs.
# Docker Compose defaults this to the local API endpoint and issues a short-lived,
# run-scoped credential automatically after the provider is signed in.
# FORGEFLOW_RUNNER_MCP_URL=http://host.docker.internal:18080/api/v1/mcp
# FORGEFLOW_RUNNER_MCP_TOKEN=ff_pat_replace_me  # legacy/manual override only
# FORGEFLOW_RUNNER_WORKSPACE_HOST_ROOT=/absolute/path/to/forgeflow/workspaces
# FORGEFLOW_RUNNER_DOCKER_WORKSPACE_ROOT=/absolute/path/to/forgeflow/workspaces
# Local ChatGPT-authenticated Codex CLI store (read-only bind mount; no OpenAI API key).
# FORGEFLOW_CODEX_AUTH_HOST_PATH=/absolute/path/to/.codex/auth.json
# Host directories used by the Settings sign-in flow. Codex must be the parent of auth.json.
# FORGEFLOW_CODEX_HOME_HOST_PATH=/absolute/path/to/.codex
# Claude CLI auth is kept in this dedicated directory and never enters API/job payloads.
# FORGEFLOW_CLAUDE_CONFIG_HOST_PATH=/absolute/path/to/.claude
# FORGEFLOW_GIT_TOKEN=short-lived-github-token-for-private-repositories
# Provider CLI profiles are mounted read-only into the runner and managed from Project Settings.
# MCP stdio settings (never pass PATs as command-line arguments).
# FORGEFLOW_MCP_TOKEN=
# FORGEFLOW_MCP_ORGANIZATION_ID=
# Optional legacy MCP project pin; leave empty for an organization-wide connection.
# FORGEFLOW_MCP_PROJECT_ID=
