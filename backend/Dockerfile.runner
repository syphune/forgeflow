FROM golang:1.26.6-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/forgeflow-runner ./cmd/runner

FROM node:22-bookworm-slim

WORKDIR /src
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/forgeflow-runner /usr/local/bin/forgeflow-runner
RUN npm install --global @openai/codex @anthropic-ai/claude-code \
    && useradd --create-home --shell /usr/sbin/nologin forgeflow

RUN mkdir -p /var/lib/forgeflow/workspaces \
    && chown -R forgeflow:forgeflow /var/lib/forgeflow
USER forgeflow
ENV HOME=/home/forgeflow
ENTRYPOINT ["/usr/local/bin/forgeflow-runner"]
